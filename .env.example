# Copy to .env.local. Production uses the same names on Render.
# The public address is Render's own hostname. No custom domain.

NEXT_PUBLIC_APP_URL=https://trapmas-eve.onrender.com

# Desk password. Required in production. Local dev uses trapmas-dev when this is empty.
ADMIN_PASSWORD=

# Long random string. Signs the admin cookie and file links.
ADMIN_SESSION_SECRET=

# Different long random string. The sync script on your computer sends this.
ADMIN_EXPORT_TOKEN=

# Local development only. Production does not use a database file or an upload folder.
# SQLITE_PATH=data/trapmas.db
# LOCAL_UPLOAD_DIR=data/uploads

# Unpaid drafts older than this are deleted from Drive the next time the site wakes.
DRAFT_TTL_DAYS=14

# Gmail is the default mailer. No domain to verify.
# Sender name defaults to Dream 2 Reality.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Dream 2 Reality
EMAIL_PROVIDER=gmail

# Optional, only after you add a domain and want Resend instead of Gmail.
# Set EMAIL_PROVIDER=resend and fill these in.
RESEND_API_KEY=
EMAIL_FROM=

# Parent folder in Drive. The app creates "TRAPMAS EVE 2026 - Rubberband OG" inside it,
# with the Sheet "TRAPMAS submissions", a Pending area, and one folder per paid artist.
GOOGLE_DRIVE_FOLDER_ID=

# Personal Gmail: OAuth refresh token with Drive AND Google Sheets scopes.
# https://www.googleapis.com/auth/drive
# https://www.googleapis.com/auth/spreadsheets
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Or a service account, only if the folder is in a Shared Drive.
# Paste the JSON, or base64 of the JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional later. Cash App manual does not use these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
